filters:
  or:
    - typ == "rodzaj"
    - typ == "rozmiar"
    - typ == "narzedzie"
    - typ == "pojazd"
views:
  - type: table
    name: Rodzaje gwiazd
    filters:
      and:
        - typ == "rodzaj"
    order:
      - nr
      - file.name
      - mnoznik
      - waga
      - model
    sort:
      - property: nr
        direction: ASC
  - type: table
    name: Rozmiary
    filters:
      and:
        - typ == "rozmiar"
    order:
      - file.name
      - studow
      - hp
      - co_ile_s
      - luck
      - strefy
    sort:
      - property: hp
        direction: ASC
  - type: table
    name: Narzędzia
    filters:
      and:
        - typ == "narzedzie"
    order:
      - file.name
      - tier
      - cena
      - obrazenia
      - model
    sort:
      - property: tier
        direction: ASC
  - type: table
    name: Pojazdy
    filters:
      and:
        - typ == "pojazd"
    order:
      - file.name
      - cena
      - predkosc
      - lata
      - na_premiere
      - model
    sort:
      - property: cena
        direction: ASC
